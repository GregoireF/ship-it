{
  "inputs": [],
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "ship-it": {
      "type": "stdio",
      "command": "ship",
      "args": [
        "mcp",
        "--client",
        "vscode"
      ]
    }
  }
}
